[Unit]
Description=Desk Dashboard git auto-update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Environment=DASHBOARD_REPO=/data/dashboard
Environment=DASHBOARD_BRANCH=main
# Repository scripts are intentionally usable even when a checkout does not preserve the
# executable bit (for example after development on Windows).
ExecStart=/usr/bin/bash /data/dashboard/deploy/scripts/update.sh
TimeoutStartSec=15min
