# Belt-and-braces: force the driver to disable power save at boot (some drivers ignore
# the NetworkManager hint). Re-run cheaply; harmless if already off.
[Unit]
Description=Disable wlan0 Wi-Fi power save (prevents drops)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/iw dev wlan0 set power_save off
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
